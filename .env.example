# Optional. The default is fully offline and makes no model/network calls.
# Set both in your shell (or an ignored .env passed to uvicorn --env-file .env).
OPENAI_API_KEY=
OXYPROOF_LLM_MODEL=
# Explicit local alternative: no OpenAI key, no cloud fallback.
# OXYPROOF_LLM_PROVIDER=ollama
# OXYPROOF_LLM_MODEL=phi4-mini:latest
# OXYPROOF_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Separate paid provider; explicit acceptance authorization and durable three-attempt cap.
DEEPSEEK_API_KEY=
